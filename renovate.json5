{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  enabledManagers: ["gomod"],
  labels: ["dependencies"],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  postUpdateOptions: ["gomodTidy"],
  packageRules: [
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchDepNames: ["go", "toolchain"],
      enabled: false,
    },
    {
      matchPackageNames: ["github.com/deckhouse/csi-ceph/**"],
      enabled: false,
    },
    {
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      groupName: "kubernetes",
    },
  ],
}
